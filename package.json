{
  "name": "react-vant-next",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "packageManager": "pnpm@9.14.4",
  "scripts": {
    "app": "turbo run app",
    "storybook": "turbo run storybook",
    "build": "turbo run build",
    "clean": "pnpm dlx turbo run clean",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "clean:w": "pnpm dlx npm-run-all clean:w:cache clean:w:deps",
    "clean:w:cache": "pnpm dlx rimraf .turbo",
    "clean:w:deps": "pnpm dlx rimraf node_modules",
    "clean:all": "pnpm dlx npm-run-all clean clean:w",
    "pack": "turbo run pack",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.13.0",
    "@changesets/cli": "^2.29.5",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint-react/eslint-plugin": "^1.52.2",
    "all-contributors-cli": "6.26.1",
    "commitlint": "19.8.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.26.0",
    "eslint-plugin-format": "^1.0.1",
    "husky": "9.1.7",
    "lint-staged": "16.1.2",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "turbo": "^2.5.3",
    "typescript": "5.8.3",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": "turbo run format --"
  },
  "volta": {
    "node": "22.15.0"
  }
}
