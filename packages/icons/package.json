{
  "name": "@react-vant-next/icons",
  "type": "module",
  "version": "1.0.2",
  "description": "React Vant Next Icons",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./es/icons/index.js",
      "require": "./lib/icons/index.js"
    }
  },
  "main": "lib/icons/index.js",
  "module": "es/icons/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "es",
    "lib",
    "package.json"
  ],
  "scripts": {
    "dev": "rollup -c -w",
    "build": "rollup -c",
    "clean": "pnpm dlx npm-run-all clean:bundle clean:cache clean:deps",
    "clean:cache": "pnpm dlx rimraf .turbo",
    "clean:bundle": "pnpm dlx rimraf dist es lib",
    "clean:deps": "pnpm dlx rimraf node_modules",
    "export": "pnpm dlx npm-run-all export:icon export:react export:format",
    "export:icon": "node ./scripts/export.mjs",
    "export:react": "pnpm dlx @svgr/cli --index-template ./index-template.cjs -d src/icons src/svg",
    "export:format": "pnpm format",
    "format": "eslint --fix"
  },
  "peerDependencies": {
    "react": ">=19",
    "tslib": "^2.4.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@svgr/cli": "8.1.0",
    "@svgr/core": "8.1.0",
    "@types/fs-extra": "^11.0.4",
    "@types/react": "^19.1.3",
    "@types/shelljs": "^0.8.15",
    "fast-glob": "3.3.3",
    "fs-extra": "11.3.0",
    "node-sketch": "0.14.1",
    "rollup": "4.44.1",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "shelljs": "0.10.0",
    "svgo": "4.0.0",
    "tslib": "^2.4.0",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "volta": {
    "node": "22.15.0"
  }
}
