{
  "name": "@react-vant-next/utils",
  "type": "module",
  "version": "1.0.2",
  "description": "React Mobile UI Components based on Vant UI - Next Generation",
  "author": "silentlee",
  "license": "MIT",
  "homepage": "https://github.com/silentlee/react-vant-next",
  "repository": {
    "type": "git",
    "url": "git@github.com:silentlee/react-vant-next.git",
    "branch": "main",
    "package": "./packages/utils"
  },
  "keywords": [
    "ui",
    "react",
    "mobile",
    "components",
    "component",
    "design",
    "framework",
    "frontend",
    "react-component",
    "utils"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./es/index.js",
      "require": "./lib/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./es/*.js",
      "require": "./lib/*.js"
    },
    "./create/*": {
      "types": "./dist/create/*.d.ts",
      "import": "./es/create/*.js",
      "require": "./lib/create/*.js"
    },
    "./dev/*": {
      "types": "./dist/dev/*.d.ts",
      "import": "./es/dev/*.js",
      "require": "./lib/dev/*.js"
    },
    "./dom/*": {
      "types": "./dist/dom/*.d.ts",
      "import": "./es/dom/*.js",
      "require": "./lib/dom/*.js"
    },
    "./event-emitter/*": {
      "types": "./dist/event-emitter/*.d.ts",
      "import": "./es/event-emitter/*.js",
      "require": "./lib/event-emitter/*.js"
    },
    "./format/*": {
      "types": "./dist/format/*.d.ts",
      "import": "./es/format/*.js",
      "require": "./lib/format/*.js"
    },
    "./lodash-like/*": {
      "types": "./dist/lodash-like/*.d.ts",
      "import": "./es/lodash-like/*.js",
      "require": "./lib/lodash-like/*.js"
    },
    "./react-util/*": {
      "types": "./dist/react-util/*.d.ts",
      "import": "./es/react-util/*.js",
      "require": "./lib/react-util/*.js"
    },
    "./validate/*": {
      "types": "./dist/validate/*.d.ts",
      "import": "./es/validate/*.js",
      "require": "./lib/validate/*.js"
    }
  },
  "main": "lib/index.js",
  "module": "es/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "es",
    "lib"
  ],
  "scripts": {
    "clean": "pnpm dlx npm-run-all clean:cache clean:bundle clean:deps",
    "clean:cache": "pnpm dlx rimraf .turbo",
    "clean:bundle": "pnpm dlx rimraf dist es lib",
    "clean:deps": "pnpm dlx rimraf node_modules",
    "lint": "eslint src --ext ts,tsx --fix",
    "lint:tsx": "eslint src --ext ts,tsx",
    "build": "cross-env NODE_ENV=production rollup -c",
    "dev": "cross-env NODE_ENV=development rollup -c -w",
    "format": "eslint --fix",
    "test": "vitest run"
  },
  "browserslist": [
    "Android >= 4.0",
    "iOS >= 8"
  ],
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/rollup-plugin-peer-deps-external": "^2.2.4",
    "globals": "^16.2.0",
    "rollup": "4.44.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-dts": "^6.2.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "ts-morph": "^26.0.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
