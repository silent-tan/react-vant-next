{
  "compilerOptions": {
    "target": "es2015",
    "jsx": "react-jsx",
    "lib": ["DOM", "ES2015"],
    "baseUrl": ".",
    "rootDir": ".",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "typeRoots": ["node_modules/@types"],
    "declaration": false,
    "importHelpers": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "pretty": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "es", "lib", "dist"]
}
