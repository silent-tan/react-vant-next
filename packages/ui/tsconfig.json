{
  "compilerOptions": {
    "target": "es2015",
    // JSX  配置
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["DOM", "ES2015"],
    "baseUrl": ".",
    "rootDir": ".",
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@react-vant-next/ui": ["src/index.ts"]
    },
    "resolveJsonModule": true,
    "typeRoots": ["src/typings", "node_modules/@types"],
    "strict": false,
    "declaration": false,
    "importHelpers": true,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "pretty": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "es", "lib"]
}
